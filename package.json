{
  "name": "dawafind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-ocr-assets.mjs && next dev",
    "build": "prisma generate && node scripts/copy-ocr-assets.mjs && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:more": "tsx prisma/seed-more.ts",
    "db:bulk": "tsx prisma/seed-bulk.ts",
    "db:reset": "bash scripts/db.sh reset && prisma db push && tsx prisma/seed.ts",
    "smoke": "node scripts/smoke.mjs",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.3.8",
    "nodemailer": "^10.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
